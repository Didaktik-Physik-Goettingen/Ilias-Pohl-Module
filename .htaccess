RewriteEngine On

# Set this to the sub-path where the module lives on the server.
# Example: if the URL is https://example.com/pohl/ use: RewriteBase /pohl/ [on the server]
# If it lives at the domain root (i.e. locally) use: RewriteBase / [local]
RewriteBase /

# ── Angular client-side routing ───────────────────────────────────────────────
# Serve real files and directories as-is; everything else → index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
